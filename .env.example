# =============================================================================
# .env.example — nombres y forma de cada variable, SIN secretos reales.
# =============================================================================
# Copien esto a .env para levantar Compose en su máquina:
#   cp .env.example .env
#
# Los valores de ejemplo de aquí SÍ sirven para desarrollo local (son
# contraseñas de un contenedor Postgres/Keycloak que solo vive en su Docker).
# Las claves marcadas "— SOLO NICOLE —" las declara únicamente la Technical
# Lead; el resto del equipo no las genera ni las cambia sin avisar.
# Ver el Anexo B de la guía de inducción del Sprint 1.
# =============================================================================

# --- Base de datos ---------------------------------------------------------
DC_DB_HOST=postgres
DC_DB_PORT=5432
DC_DB_NAME=doggycredit
DC_DB_USER=doggy_app
DC_DB_PASSWORD=dev_only_change_me
# DEBT-018: credenciales separadas para la app (sin superusuario).
# Flyway sigue usando DC_DB_USER/DC_DB_PASSWORD (el admin).
DC_APP_DB_USER=doggycredit_app
DC_APP_DB_PASSWORD=dev_only_app_role

# --- Keycloak ---------------------------------------------------------------
DC_KEYCLOAK_ISSUER_URI=https://localhost/auth/realms/doggycredit
DC_KEYCLOAK_ADMIN_USER=admin
# — SOLO NICOLE — (solo para importar el realm localmente)
DC_KEYCLOAK_ADMIN_PASSWORD=dev_only_change_me
# — SOLO NICOLE — secreto del cliente doggycredit-api-admin, con el que la API
# crea y revoca las claves de API (D-09). Keycloak lo lee al importar el realm
# y la API lo usa para autenticarse; debe ser el mismo en los dos.
DC_KEYCLOAK_API_ADMIN_SECRET=dev_only_change_me

# --- Cifrado por campo (ADR-009) --------------------------------------------
# — SOLO NICOLE — clave maestra que envuelve la DEK por tenant.
# Nunca es la misma en dos ambientes; la app se niega a arrancar en
# producción si detecta este valor de ejemplo.
DC_MASTER_KEY=dev-only-insecure-master-key-do-not-use-in-prod

# --- Simuladores (WireMock) --------------------------------------------------
# Conector del buró (RF-INT-02.1). Fuera de Compose: http://localhost:8089
DC_INTEGRATION_BUREAU_URL=http://wiremock-bureau:8080
DC_INTEGRATION_BUREAU_CONNECT_TIMEOUT=500ms
DC_INTEGRATION_BUREAU_READ_TIMEOUT=1500ms
# Core bancario (B-03). Fuera de Compose: http://localhost:8090
DC_INTEGRATION_BANK_URL=http://wiremock-bank:8080
DC_INTEGRATION_BANK_CONNECT_TIMEOUT=500ms
DC_INTEGRATION_BANK_READ_TIMEOUT=1500ms
# Billetera móvil (B-05). Fuera de Compose: http://localhost:8091
DC_INTEGRATION_WALLET_URL=http://wiremock-wallet:8080
DC_INTEGRATION_WALLET_CONNECT_TIMEOUT=500ms
DC_INTEGRATION_WALLET_READ_TIMEOUT=1500ms

# --- Correlación --------------------------------------------------------------
DC_CORRELATION_HEADER=X-Correlation-Id

# --- Semilla de demo (usuarios sembrados en seed/tenants.yaml) ---------------
# — SOLO NICOLE — genera y declara estas contraseñas/secretos de demo.
DC_SEED_ADMIN_PASSWORD=dev_only_change_me
DC_SEED_ANALYST_PASSWORD=dev_only_change_me
DC_SEED_ADMIN_PASSWORD_2=dev_only_change_me
# Operador de la plataforma (PLATFORM_ADMIN) que cambia planes: A-11 / LOS-115.
DC_SEED_PLATFORM_ADMIN_PASSWORD=dev_only_change_me
DC_SEED_M2M_SECRET=dev_only_change_me
DC_SEED_M2M_SECRET_2=dev_only_change_me

# --- Puertos publicados (host) ------------------------------------------------
DC_HTTP_PORT=443
DC_KEYCLOAK_HOST_PORT=8081
DC_WIREMOCK_BUREAU_HOST_PORT=8089
DC_WIREMOCK_BANK_HOST_PORT=8090
DC_WIREMOCK_WALLET_HOST_PORT=8091
DC_GRAFANA_HOST_PORT=3300
