# Caddy: único punto de entrada público. Solo TLS, estáticos y enrutado.
# NUNCA autoriza nada -- eso vive en doggycredit-api (Spring Security).
# El issuer determina el dominio; no se introduce otra variable de entorno.
{
	auto_https disable_redirects
}

# Los snippets deben definirse antes de importarse.
(routes) {
	handle /auth/* {
		reverse_proxy keycloak:8080
	}

	handle_path /api/v1/* {
		reverse_proxy doggycredit-api:8080 {
			# Nunca reenviar una cabecera de tenant entrante: el tenant sale solo del token.
			header_up -X-Tenant-*
		}
	}

	handle /actuator/health {
		reverse_proxy doggycredit-api:8080
	}

	handle /actuator/* {
		respond 404
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
		# Solo la SPA: Keycloak publica sus propias cabeceras de frame y necesita
		# enmarcar su login-status-iframe en /auth/* desde el mismo origen.
		header X-Frame-Options DENY
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
}

https://localhost {
	tls internal
	# Solo local (configure_demo.py lo quita en la VM): el HSTS de Keycloak haría
	# que el navegador forzara HTTPS en cualquier http://localhost:PUERTO de otros
	# proyectos. max-age=0 lo anula y además borra el que ya estuviera guardado.
	header >Strict-Transport-Security "max-age=0"
	import routes
}
